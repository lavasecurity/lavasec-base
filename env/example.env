# Template only. On the VM: install to /etc/lavasec/lavasec.env, root:root 600.
# Never commit real values anywhere.

# Local-only auth between pi and the gateway. Must start with sk- (LiteLLM
# requirement); generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-CHANGE-ME

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
NEURALWATT_API_KEY=
# Synthetic New (state-of-the-art frontier model aggregation, OpenAI-compatible at https://api.synthetic.new/v1)
SYNTHETIC_API_KEY=
# Ollama Cloud (hosted, OpenAI-compatible at https://ollama.com/v1)
OLLAMA_API_KEY=

# Langfuse tracing (optional). Set all three to enable — the gateway then
# traces every client's requests.
# HOST MUST MATCH THE REGION YOUR PROJECT LIVES IN — keys are region-scoped
# and the wrong host fails auth silently at runtime:
#   US: https://us.cloud.langfuse.com
#   EU: https://cloud.langfuse.com
#   self-hosted: your own URL
# 30-gateway.sh verifies the credentials against this host and refuses to
# enable tracing if they don't authenticate.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional local evaluation callback installed by scripts/35-eval-receiver.sh.
GENERIC_LOGGER_ENDPOINT=http://127.0.0.1:4010/
# GEMINI_API_KEY=
