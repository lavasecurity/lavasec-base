# Template only. On the VM: install to /etc/lavasec/lavasec.env, root:root 600.
# Never commit real values anywhere.

# Local-only auth between pi and the gateway. Must start with sk- (LiteLLM
# requirement); generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-CHANGE-ME

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
NEURALWATT_API_KEY=

# Langfuse tracing (optional). Set all three to enable — the gateway then
# traces every client's requests. Keys from cloud.langfuse.com → project
# settings. Self-hosting: point LANGFUSE_HOST at your instance instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# GEMINI_API_KEY=
